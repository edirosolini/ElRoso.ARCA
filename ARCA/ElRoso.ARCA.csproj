<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Target framework -->
		<TargetFramework>net9.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>

		<!-- Assembly / Package identity -->
		<AssemblyName>ElRoso.ARCA</AssemblyName>
		<RootNamespace>ElRoso.ARCA</RootNamespace>
		<PackageId>ElRoso.ARCA</PackageId>
		<Version>3.1.0</Version>

		<!-- Authoring -->
		<Authors>Di Rosolini Ezequiel</Authors>
		<Company>El Roso</Company>
		<Copyright>Copyright (c) Di Rosolini Ezequiel</Copyright>

		<!-- Package description (shown on NuGet.org) -->
		<Title>ElRoso.ARCA — .NET client for Argentine ARCA (ex-AFIP) e-invoicing</Title>
		<Description>Cliente .NET 9 para facturación electrónica con ARCA (ex-AFIP). Autenticación WSAA, emisión de comprobantes domésticos (WSFEv1) y de exportación (WSFEXv1), y validación de CUIT por padrón. Hecho para devs argentinos que sufrieron integrando con AFIP.</Description>
		<PackageTags>arca;afip;facturacion-electronica;cae;wsaa;wsfe;wsfev1;wsfexv1;padron;argentina;electronic-invoicing;dotnet;csharp</PackageTags>

		<!-- Package URLs / repo -->
		<RepositoryUrl>https://github.com/edirosolini/ElRoso.ARCA</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageProjectUrl>https://github.com/edirosolini/ElRoso.ARCA</PackageProjectUrl>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>

		<!-- License -->
		<PackageLicenseExpression>MIT</PackageLicenseExpression>

		<!-- README packaged with nupkg (shown on NuGet.org package page) -->
		<PackageReadmeFile>README.md</PackageReadmeFile>

		<!-- XML docs + symbols + SourceLink for debugging into the package -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<DocumentationFile>$(OutputPath)$(AssemblyName).xml</DocumentationFile>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<DebugType>portable</DebugType>

		<!-- Deterministic build in CI for reproducible packages -->
		<Deterministic>true</Deterministic>
		<ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<!-- README included as package content -->
	<ItemGroup>
		<None Include="..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="FluentValidation" Version="12.1.1" />
		<PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="9.0.16" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.400">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="StyleCop.Analyzers" Version="1.1.118">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.12" />
		<PackageReference Include="System.ServiceModel.Duplex" Version="6.0.0" />
		<PackageReference Include="System.ServiceModel.Federation" Version="8.1.2" />
		<PackageReference Include="System.ServiceModel.Http" Version="8.1.2" />
		<PackageReference Include="System.ServiceModel.NetTcp" Version="8.1.2" />
		<PackageReference Include="System.ServiceModel.Security" Version="6.0.0" />
	</ItemGroup>

</Project>
